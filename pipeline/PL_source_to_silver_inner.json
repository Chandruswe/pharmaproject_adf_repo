{
	"name": "PL_source_to_silver_inner",
	"properties": {
		"activities": [
			{
				"name": "Lookup_table_details_from_ctrltable",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT * FROM ctrl.table_config where table_id=@{pipeline().parameters.table_id}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSqlTable",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Set run starttime",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "start time",
					"value": {
						"value": "@formatDateTime(utcNow(),'yyyy:MM:dd_hh:mm:ss')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "source to landing ingestion",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Check load type",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "PostgreSqlV2Source",
						"query": {
							"value": "select * from PUBLIC.@{activity('Lookup_table_details_from_ctrltable').output.firstRow.source_table_name}\n@{\n    if(equals(activity('Lookup_table_details_from_ctrltable').output.firstRow.load_type,'FULL')\n    ,'',\n    concat('where', activity('Lookup_table_details_from_ctrltable').output.firstRow.watermark_column ,'> ','''',variables('watermark_value'),'''') \n    )\n}\n\n\n",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_PostgreSqlTable",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_ADLS_Parquet",
						"type": "DatasetReference",
						"parameters": {
							"container": "landing",
							"folder": {
								"value": "@concat(activity('Lookup_table_details_from_ctrltable').output.firstRow.source_system,'/',activity('Lookup_table_details_from_ctrltable').output.firstRow.source_table_name,'/',variables('start time'))",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "landing to bronze",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "source to landing ingestion",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Pharmaproject-repo/pharmaproject_adb_repo/landing_to_bronze",
					"baseParameters": {
						"landing_timestamp": {
							"value": "@variables('start time')",
							"type": "Expression"
						},
						"source_system": {
							"value": "@activity('Lookup_table_details_from_ctrltable').output.firstRow.source_system",
							"type": "Expression"
						},
						"table_name": {
							"value": "@activity('Lookup_table_details_from_ctrltable').output.firstRow.bronze_table_name",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks_Pharmaproject",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "bronze to silver",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "landing to bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Pharmaproject-repo/pharmaproject_adb_repo/bronze_to_silver",
					"baseParameters": {
						"landing_timestamp": {
							"value": "@variables('start time')",
							"type": "Expression"
						},
						"tablename": {
							"value": "@activity('Lookup_table_details_from_ctrltable').output.firstRow.bronze_table_name",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks_Pharmaproject",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Auditing Success status",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "bronze to silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_AzureSqlDatabase_Pharmaproject",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "update ctrl.audit_log set STATUS='SUCCESS',END_TIME=SYSUTCDATETIME(),RECORDS_WRITTEN=@{activity('bronze to silver').output.runOutput} WHERE adf_run_id=@{pipeline().parameters.adf_run_id} and table_id=@{pipeline().parameters.table_id}",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "Check load type",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Lookup_table_details_from_ctrltable",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set run starttime",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('Lookup_table_details_from_ctrltable').output.firstRow.load_type,'FULL' ))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "lookup the watermark value",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "select watermark_value from ctrl.watermark where table_id=@{pipeline().parameters.table_id}",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_AzureSqlTable",
									"type": "DatasetReference"
								}
							}
						},
						{
							"name": "storing watermark value",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "lookup the watermark value",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "watermark_value",
								"value": {
									"value": "@activity('Lookup_table_details_from_ctrltable').output.firstRow.watermark_value",
									"type": "Expression"
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"table_id": {
				"type": "string",
				"defaultValue": "1"
			},
			"adf_run_id": {
				"type": "string"
			}
		},
		"variables": {
			"start time": {
				"type": "String"
			},
			"watermark_value": {
				"type": "String"
			}
		},
		"annotations": []
	}
}